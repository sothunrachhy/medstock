# Copy to frontend/.env (local) or set in Vercel → Settings → Environment Variables.

# Address of the API, used by the browser. Default: /api on the same domain as the website.
# Set it only when the API is on another domain, e.g. https://api.example.com/api
# (the API must then allow CORS from the website, and connect-src in vercel.json must list it).
VITE_API_URL=

# Local development only: where `npm run dev` forwards /api requests.
API_PROXY_TARGET=http://localhost:5000
