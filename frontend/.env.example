# Copy to frontend/.env (local) or set in Vercel → Settings → Environment Variables.

# Base URL of the FastAPI backend (msm_api), used by the browser. Default: /api/v1 on the same
# domain as the website. Set it only when the API is on another domain, e.g.
#   VITE_API_URL=https://api.example.com/api/v1
# The API must then allow the website in WHITE_LIST_CORS, set COOKIE_DOMAIN so the CSRF cookie is
# readable here (same parent domain), and connect-src in vercel.json must list the API.
VITE_API_URL=

# Local development only: where `npm run dev` forwards /api requests (the msm_api server).
API_PROXY_TARGET=http://127.0.0.1:8000
