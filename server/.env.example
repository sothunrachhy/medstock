PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/medstock
# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Session timeout, password length and account lockout are set in the app: Settings → Auth
# Comma-separated list of allowed browser origins, e.g. https://medstock.example.com
# (leave empty: any origin in development, same-site only in production)
CLIENT_ORIGIN=http://localhost:5173
# Batches expiring within this many days are flagged as "near expiry"
EXPIRY_WARN_DAYS=90
# Set to 1 when running behind a reverse proxy (nginx, Vercel) so login history records the real IP
TRUST_PROXY=
# Initial admin account created by `npm run seed`.
# On a local database an empty ADMIN_PASSWORD falls back to admin123; on any other
# database (Atlas, a server) ADMIN_PASSWORD is required (at least 8 characters).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
