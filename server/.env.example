PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/medstock
# Change this to a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
# Session timeout, password length and account lockout are set in the app: Settings → Auth
# Comma-separated list of allowed browser origins (leave empty to allow all in development)
CLIENT_ORIGIN=http://localhost:5173
# Batches expiring within this many days are flagged as "near expiry"
EXPIRY_WARN_DAYS=90
# Set to 1 when running behind a reverse proxy (nginx) so login history records the real IP
TRUST_PROXY=
# Initial admin account created by `npm run seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
